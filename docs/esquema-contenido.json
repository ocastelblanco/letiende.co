  "notas_implementacion": {
    "google_apps_script": {
      "endpoint": "https://api.letiende.co/actualizarContenido",
      "metodo": "POST",
      "headers": {
        "Content-Type": "application/json",
        "Origin": "https://script.google.com"
      },
      "autenticacion": "Se valida el origen en la función Lambda",
      "manejo_errores": "La API retorna statusCode 200 si OK, 400/500 si error"
    },
    "almacenamiento_s3": {
      "bucket": "letiende-assets",
      "ruta": "data/{seccion}.json",
      "ejemplo": "data/inicio.json, data/menu.json, data/eventos.json",
      "permisos": "Lectura pública, escritura solo desde Lambda",
      "versionado": "Recomendado activar versionado en S3 para respaldos"
    },
    "validaciones": {
      "seccion_requerida": "El campo 'seccion' es obligatorio",
      "idioma_minimo": "Debe incluir al menos 'es' (español)",
      "timestamp_automatico": "Se agrega automáticamente si no existe",
      "sanitizacion": "Se valida que no haya código malicioso en el JSON"
    },
    "extensibilidad": {
      "nuevos_idiomas": "Solo agregar nueva clave en el objeto 'idiomas' (ej: 'fr', 'de', 'pt')",
      "nuevas_secciones": "Agregar nombre a array secciones_validas y crear estructura similar",
      "campos_personalizados": "Usar el objeto 'metadata' para campos específicos de cada sección"
    }
  }
}
