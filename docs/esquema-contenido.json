{
  "$schema": "Esquema de contenido para Le Tiende - Google Apps Script → AWS Lambda → S3",
  "version": "1.0.0",
  "descripcion": "Este esquema define la estructura del JSON que se envía desde Google Apps Script a la API de Lambda para almacenar contenido en S3",

  "estructura": {
    "seccion": "string (requerido) - Identificador de la sección del sitio",
    "idiomas": "object (requerido) - Contenido en diferentes idiomas",
    "metadata": "object (opcional) - Metadatos adicionales",
    "timestamp": "string (automático) - Fecha/hora de última actualización"
  },

  "secciones_validas": [
    "inicio",
    "menu",
    "eventos",
    "auditorio",
    "libreria",
    "contacto",
    "nosotros"
  ],

