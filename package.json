{
  "name": "letiende.co",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:letiende.co": "node dist/letiende.co/server/server.mjs",
    "build:ssr": "ng build --configuration production",
    "build:ssr:dev": "ng build --configuration production --base-href /dev/",
    "build:ssr:prod": "ng build --configuration production --base-href /",
    "deploy:dev": "npm run build:ssr:dev && sls deploy --stage dev",
    "deploy:prod": "npm run build:ssr:prod && sls deploy --stage prod",
    "deploy": "npm run deploy:dev"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.3",
    "@angular/cdk": "^21.1.3",
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/fire": "^21.0.0-rc.0",
    "@angular/forms": "^21.1.3",
    "@angular/platform-browser": "^21.1.3",
    "@angular/platform-server": "^21.1.3",
    "@angular/router": "^21.1.3",
    "@angular/ssr": "^21.1.2",
    "@cloudinary/ng": "^2.1.5",
    "@cloudinary/url-gen": "^1.21.0",
    "@codegenie/serverless-express": "^4.16.0",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@primeuix/themes": "^2.0.3",
    "cloudinary": "^2.7.0",
    "express": "^5.1.0",
    "primeng": "^21.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.3",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.13.4",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "serverless": "^4.31.2",
    "typescript": "~5.9.3"
  }
}
